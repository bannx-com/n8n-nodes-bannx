{
	"name": "n8n-nodes-bannx",
	"version": "0.1.0",
	"description": "Render bannx design templates to images, PDFs and videos from n8n, and start workflows when a render finishes.",
	"license": "MIT",
	"homepage": "https://bannx.com/docs/integrations/n8n",
	"keywords": [
		"n8n-community-node-package",
		"bannx",
		"image generation",
		"pdf",
		"video",
		"templates"
	],
	"author": {
		"name": "bannx",
		"email": "contact@bannx.com",
		"url": "https://bannx.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/bannx-com/n8n-nodes-bannx.git"
	},
	"bugs": {
		"url": "https://github.com/bannx-com/n8n-nodes-bannx/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/BannxApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Bannx/Bannx.node.js",
			"dist/nodes/BannxTrigger/BannxTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.56.4",
		"eslint": "9.39.4",
		"n8n-workflow": "2.16.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
